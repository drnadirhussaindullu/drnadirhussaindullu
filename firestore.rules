rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all rule: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'nh979681@gmail.com' ||
        request.auth.token.email == 'superadmin@gulzarfamilyhospital.com' ||
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    function isStaffAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admin profiles collection: Super Admin has full authority, standard admins only read self
    match /admins/{adminId} {
      allow read: if isSuperAdmin() || (isSignedIn() && request.auth.uid == adminId);
      allow write: if isSuperAdmin();
    }

    // Appointments collection: Public create, Staff manage, Patient read-own
    match /appointments/{appointmentId} {
      allow read: if isStaffAdmin() || (isSignedIn() && (resource.data.whatsAppNumber == request.auth.token.phone_number || resource.data.patientId == request.auth.uid));
      allow create: if true; // Public booking submissions
      allow update: if isStaffAdmin() || (isSignedIn() && resource.data.patientId == request.auth.uid);
      allow delete: if isStaffAdmin();
    }

    // Immutable Audit Logs collection: Strictly immutable, Super Admin read-only
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isStaffAdmin();
      allow update, delete: if false; // Strict immutability guarantee
    }

    // Patient Health Profiles: Isolated to patient owner & staff doctors
    match /patients/{patientId} {
      allow read: if isStaffAdmin() || (isSignedIn() && request.auth.uid == patientId);
      allow create: if true; // New patient registration
      allow update: if isStaffAdmin() || (isSignedIn() && request.auth.uid == patientId);
      allow delete: if isSuperAdmin();
    }

    // Hospital Public Info, Services & Doctors: Public read, Staff/Super Admin write
    match /hospital_info/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isStaffAdmin();
    }

    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if isStaffAdmin();
    }

    // App Download & Mobile Ecosystem: Public read, Super Admin update
    match /app_download_config/{configId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Broadcast Notifications: Public read, Staff broadcast creation
    match /notifications/{notifId} {
      allow read: if true;
      allow create: if isStaffAdmin();
      allow update, delete: if isStaffAdmin();
    }
  }
}
